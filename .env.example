# Optional. Leave blank to paste a key in the UI instead (the key is sent per request, never stored).
ANTHROPIC_API_KEY=

# llm = natural phrasing (guarded, falls back to templates); template = fully deterministic replies
SOP_RESPONDER_MODE=llm
SOP_EXTRACTOR_MODEL=claude-haiku-5-5
SOP_RESPONDER_MODEL=claude-sonnet-5-5

# Pin "today" for deadline maths (YYYY-MM-DD); leave unset for the real date
# SOP_TODAY=2026-11-07
